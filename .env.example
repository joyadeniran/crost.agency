# Crost digital experience — environment contract.
# Copy to .env.local and fill in. Every variable is server-only: none of these
# are prefixed NEXT_PUBLIC_, so none of them reach the browser bundle.

# ---------------------------------------------------------------------------
# Supabase (required for anything to persist)
# ---------------------------------------------------------------------------
# Without these, /api/diagnostic and /api/apply return a 503 with an honest
# "not configured" message rather than a stack trace.
# The service role key bypasses RLS — it is only ever used inside API routes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend (required for real email delivery)
# ---------------------------------------------------------------------------
# Without this, emails are logged to the server console instead of sent, and
# the diagnostic/application still completes and stores normally.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
EMAIL_FROM="Crost Agency <hello@crost.agency>"
# Where internal new-lead notifications go.
EMAIL_INTERNAL_TO=brand@crost.agency

# ---------------------------------------------------------------------------
# Anthropic (optional — AI narrative)
# ---------------------------------------------------------------------------
# Without this, the result narrative falls back to a deterministic template.
# It is never a fabricated "AI" response.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for absolute links in emails, OG tags, sitemap and
# robots.txt. No trailing slash. On Vercel this falls back to VERCEL_URL, and
# in local dev to http://localhost:3000, so it is only strictly required for
# a custom production domain.
NEXT_PUBLIC_SITE_URL=https://crost.agency
